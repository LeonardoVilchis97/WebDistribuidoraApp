@model WebApplicationDistribuidoraApp.Models.Producto

@{
    ViewData["Title"] = "Producto";
    var tipos = ViewBag.TiposProducto as List<WebApplicationDistribuidoraApp.Models.TiposProducto>;
    var proveedores = ViewData["ProveedoresProducto"]
        as IEnumerable<WebApplicationDistribuidoraApp.Models.ProductoProveedor>;
}

<div class="container mt-4 container-producto">

    <div class="card shadow-sm card-producto">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                @(Model.idProducto == Guid.Empty ? "Agregar Producto" : "Editar Producto")
            </h4>
        </div>

        <div class="card-body">
            <div class="toast-container position-fixed top-0 end-0 p-3">
                <div id="toastMensaje"
                     class="toast text-bg-danger border-0"
                     role="alert">
                    <div class="d-flex">
                        <div id="toastTexto" class="toast-body"></div>
                        <button type="button"
                                class="btn-close btn-close-white me-2 m-auto"
                                data-bs-dismiss="toast">
                        </button>
                    </div>
                </div>
            </div>
            <form asp-action="Insertar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="idProducto" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="nombre" class="form-label"></label>
                        <input asp-for="nombre" class="form-control" />
                        <span asp-validation-for="nombre" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="clave" class="form-label"></label>
                        <input asp-for="clave" class="form-control" />
                        <span asp-validation-for="clave" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                    <label for="precioVenta" class="form-label">Precio Venta</label>
                    <input asp-for="precioVenta"
                           id="precioVenta"
                           type="number"
                           class="form-control" />
                    <span asp-validation-for="precioVenta" class="text-danger"></span>
                </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tipo de Producto</label>
                        <select asp-for="idTipoProducto" class="form-select">
                            <option value="">Seleccione...</option>
                            @if (tipos != null)
                            {
                                foreach (var tipo in tipos)
                                {
                                    <option value="@tipo.idTipoProducto">@tipo.nombre</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="idTipoProducto" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="activo" class="form-check-input" />
                    <label asp-for="activo" class="form-check-label">Activo</label>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success">Guardar</button>
                </div>

            </form>
            <hr />
            <h5>Proveedores del Producto</h5>

            @if (proveedores != null && proveedores.Any())
            {
                @await Html.PartialAsync("_ProductoProveedor", proveedores)
            }
            else
            {
                <div class="alert alert-info">
                    Este producto aún no tiene proveedores asignados.
                </div>
            }
            <div class="mt-3">
                @if (Model.idProducto != Guid.Empty)
                {
                    <button type="button"
                            class="btn btn-success"
                            data-bs-toggle="modal"
                            data-bs-target="#modalAgregarProveedor"
                            data-url="@Url.Action("AgregarProveedor", "Producto", new { idProducto = Model.idProducto })">
                        Agregar Proveedor
                    </button>
                }
                else
                {
                    <div class="text-muted">
                        Guarda el producto primero para poder agregar proveedores.
                    </div>
                }
            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="modalAgregarProveedor" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="modalAgregarProveedorContent">
            <div class="modal-body text-center">
                Cargando...
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="./js/editarProducto.js"> </script>
    <script>
        editarProducto.inicializarModal();
        editarProducto.inicializarFormularioModal();
    </script>
}
